services:

  webui:
    build: ./webui
    restart: unless-stopped
    ports:
      - "127.0.0.1:8080:80"
    environment:
      API_BASE_URL: http://api:8000
      # DEMO SERVER ONLY: shows a "demo, accounts are deleted" notice (0 = none)
      ACCOUNT_LIFETIME_HOURS: "{{ demo_account_lifetime_hours | default(0) }}"
      # Link to the client download page (roles/downloads); empty = no link
      DOWNLOAD_URL: "{{ '/download/' if client_downloads_src | default('') else '' }}"
    networks:
      - internal
    depends_on:
      - api

  api:
    build: ./api
    restart: unless-stopped
    environment:
      DATABASE_URL:       mysql+pymysql://cryptuser:{{ db_password }}@db:3306/cryptdb
      JWT_SECRET_KEY:              "{{ jwt_secret_key }}"
      JWT_REFRESH_EXPIRE_DAYS:     {{ jwt_refresh_expire_days | default(7) }}
      SMTP_HOST:                   {{ smtp_host | default("") }}
      SMTP_PORT:                   {{ smtp_port | default(587) }}
      SMTP_USER:                   {{ smtp_user | default("") }}
      SMTP_PASSWORD:               {{ smtp_password | default("") }}
      SMTP_FROM:                   {{ smtp_from | default("") }}
      # starttls (587) or ssl (465); empty = ssl on port 465, otherwise starttls
      SMTP_SECURITY:               "{{ smtp_security | default('') }}"
      BASE_URL:                    https://{{ domain }}
      REQUIRE_EMAIL_VERIFICATION:  {{ require_email_verification | default("true") }}
      # Peers whose X-Forwarded-For is believed (CIDRs, comma-separated): the web UI
      # container and nginx reach the API from private Docker addresses. Rate limits
      # and audit logs use the real client address from that header.
      TRUSTED_PROXIES:             {{ trusted_proxies | default("127.0.0.0/8,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16") }}
      # HMAC key for refresh token hashing – generate with: openssl rand -hex 32
      REFRESH_TOKEN_HMAC_KEY:      "{{ refresh_token_hmac_key }}"
      TOTP_ENCRYPTION_KEY:         "{{ totp_encryption_key }}"
      # "password,totp": a password alone opens nothing but the setup of the authenticator app
      REQUIRED_FACTORS:            "{{ required_factors | default('password,totp') }}"
      # Wait before a new SSH key or an account deletion takes effect; the owner can cancel
      CHANGE_DELAY_HOURS:          "{{ change_delay_hours | default(24) }}"
      SFTP_PORT:                   "{{ sftp_port | default(2222) }}"
      # DEMO SERVER ONLY (all off by default; see api/config.py)
      DEFAULT_QUOTA_MB:            "{{ demo_quota_mb | default(10240) }}"
      MAX_USERS:                   "{{ demo_max_users | default(0) }}"
      ACCOUNT_LIFETIME_HOURS:      "{{ demo_account_lifetime_hours | default(0) }}"
      RECOVERY_POLICY:             "{{ recovery_policy | default('user') }}"
      ESCROW_PUBLIC_KEY:           "{{ escrow_public_key | default('') }}"
      # Shared secret for the daemon socket (generated by the cryptdaemon role)
      DAEMON_AUTH_KEY:             "{{ daemon_auth_key }}"
      # Scrypt cost parameter (power of 2). 17=production, 15=low-mem
      JWT_EXPIRE_MINUTES: "60"
      SERVER_HOST:        {{ domain }}
      # Public host keys of the SFTP service, handed to clients so they pin it without a prompt
      SFTP_HOST_KEY_FILES: /etc/cryptstorage/sftp-hostkeys/id_ed25519.pub,/etc/cryptstorage/sftp-hostkeys/id_ecdsa.pub,/etc/cryptstorage/sftp-hostkeys/id_rsa.pub
      # No CORS_ORIGINS: the web UI calls the API server-side, and the Go client is not a browser
    volumes:
      # Mount the directory, not the socket file: the daemon recreates the socket
      # on restart and a bind-mounted file would keep pointing at the deleted one.
      - /run/cryptdaemon:/run/cryptdaemon
      # Only the public halves of the SFTP host keys (created by the cryptdaemon role)
      - {{ install_dir }}/sftpgo/id_ed25519.pub:/etc/cryptstorage/sftp-hostkeys/id_ed25519.pub:ro
      - {{ install_dir }}/sftpgo/id_ecdsa.pub:/etc/cryptstorage/sftp-hostkeys/id_ecdsa.pub:ro
      - {{ install_dir }}/sftpgo/id_rsa.pub:/etc/cryptstorage/sftp-hostkeys/id_rsa.pub:ro
    # The API runs as a non-root user; the socket is root:cryptapi 0660
    group_add:
      - "{{ cryptapi_gid | default(3000) }}"
    # Host-local only: nginx (/api/), the Go client via nginx, and health checks
    ports:
      - "127.0.0.1:8000:8000"
    networks:
      - internal
    depends_on:
      - db

  # The storage service: virtual users, public-key SFTP only, quotas. Managed by cryptdaemon through
  # its REST API on the loopback (SFTPGo, AGPL-3.0: https://github.com/drakkan/sftpgo). No web interfaces.
  sftpgo:
    # Pinned by digest as well (multi-arch index): a re-pushed tag cannot change what runs.
    # Update both together; scripts/install_sftpgo.sh pins the same version for the test server.
    image: drakkan/sftpgo:v2.7.6@sha256:1edd28d80de2a008863fbfc58c8ff7db47b1b410bae48d4e6076192337809b11
    restart: unless-stopped
    # the storage account of the host (cryptdaemon role), which owns the storage and the state below
    user: "{{ storage_account_uid }}:{{ storage_account_gid }}"
    environment:
      SFTPGO_DATA_PROVIDER__CREATE_DEFAULT_ADMIN: "1"
      SFTPGO_DEFAULT_ADMIN_USERNAME: cryptstorage
      SFTPGO_DEFAULT_ADMIN_PASSWORD: "{{ sftpgo_admin_password }}"
      SFTPGO_SFTPD__BINDINGS__0__PORT: "2022"
      SFTPGO_SFTPD__PASSWORD_AUTHENTICATION: "0"
      SFTPGO_SFTPD__KEYBOARD_INTERACTIVE_AUTHENTICATION: "0"
      SFTPGO_HTTPD__BINDINGS__0__PORT: "8080"
      SFTPGO_HTTPD__BINDINGS__0__ENABLE_WEB_ADMIN: "0"
      SFTPGO_HTTPD__BINDINGS__0__ENABLE_WEB_CLIENT: "0"
      SFTPGO_COMMON__DEFENDER__ENABLED: "1"
    ports:
      - "{{ sftp_port | default(2222) }}:2022"
      - "127.0.0.1:8081:8080"
    volumes:
      - {{ storage_dir | default('/srv/cryptstorage') }}:{{ storage_dir | default('/srv/cryptstorage') }}
      # its user database and SSH host keys (clients pin the host key): keep and back up
      - {{ install_dir }}/sftpgo:/var/lib/sftpgo

  db:
    image: mariadb:11
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: {{ db_root_password }}
      MYSQL_DATABASE:      cryptdb
      MYSQL_USER:          cryptuser
      MYSQL_PASSWORD:      {{ db_password }}
    volumes:
      - db_data:/var/lib/mysql
    networks:
      - internal

networks:
  internal:
    driver: bridge

volumes:
  db_data:
